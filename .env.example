# This is an example file. Copy it to .env and fill in your actual configuration.

# -- SQL Server Configuration --
# This password is used by the SQL Server container to initialize the 'sa' user.
# It MUST NOT contain special characters to ensure compatibility.
SA_PASSWORD=yourStrongPassword123

# -- Backend Database Connection --
# These variables are used by the backend service to connect to the database.
# The password here MUST MATCH the SA_PASSWORD above.
DATABASE_USER=sa
DATABASE_PASSWORD=yourStrongPassword123
DATABASE_SERVER=sqlserver
DATABASE_NAME=esport_event

# -- Docker & SQL Server EULA --
# You must agree to the End-User Licensing Agreement to use the SQL Server image.
ACCEPT_EULA=Y

# -- Optional Stream URL --
# URL for the event stream, fetched by the frontend.
STREAM_URL=https://www.twitch.tv/cesi_esport
