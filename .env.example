# This is an example file. Copy it to .env and fill in your actual configuration.

# -- PostgreSQL Configuration --
# These variables are used by the postgres container to initialize the database and user.
# They are also used by the backend service to connect to the database.
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=yourStrongPassword123
POSTGRES_DB=esport_event
POSTGRES_HOST=postgres

# -- Optional Stream URL --
# URL for the event stream, fetched by the frontend.
STREAM_URL=https://www.twitch.tv/cesi_esport

# -- Admin Password --
# Password to access the admin dashboard.
ADMIN_PASSWORD=your_admin_password
